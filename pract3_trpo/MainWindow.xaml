<Window x:Class="pract3_trpo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract3_trpo"
        mc:Ignorable="d"
                Title="Спортивный абонемент" Height="600" Width="800"  Background="#E8ECEF">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Новый абонемент"   FontWeight="Bold" FontSize="20" Foreground="White" Background="#2F5D50" Padding="15,12"/>
        <TextBlock DockPanel.Dock="Bottom" Text="Стоимость: 3 500 ₽" Background="LightGray" FontSize="14" Padding="15,12"/>

        <Border Background="White" Margin="15" Padding="20" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Клиент" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО" Margin="0,0,10,8"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон" Margin="0,0,10,0"/>
                    <TextBox   Grid.Row="1" Grid.Column="1"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock  Grid.Row="0" Grid.Column="0" Text="Дата рождения" Margin="0,0,10,8"/>
                    <DatePicker Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
                    <TextBlock  Grid.Row="1" Grid.Column="0" Text="Номер карты" Margin="0,0,10,0"/>
                    <TextBox    Grid.Row="1" Grid.Column="1" Text="k-2026-035"/>
                </Grid>

                
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,20,0">
                    
                    <TextBlock Text="Параметры абонемента" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Вид абонемента" Margin="0,0,10,8"/>
                        <ComboBox  Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" SelectedIndex="0">
                            <ComboBoxItem Content="Стандарт"/>
                            <ComboBoxItem Content="Премиум"/>
                            <ComboBoxItem Content="VIP"/>
                        </ComboBox>

                        <TextBlock  Grid.Row="1" Grid.Column="0" Text="Дата начала" Margin="0,0,10,8"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Срок действия" Margin="0,0,10,8"/>
                        <ComboBox  Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" SelectedIndex="0">
                            <ComboBoxItem Content="1 месяц"/>
                            <ComboBoxItem Content="3 месяца"/>
                            <ComboBoxItem Content="12 месяцев"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Тренер" Margin="0,0,10,0"/>
                        <ComboBox  Grid.Row="3" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="Без тренера"/>
                            <ComboBoxItem Content="Соколов А.В."/>
                            <ComboBoxItem Content="Иванов В.К."/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Режим посещения" FontWeight="Bold" FontSize="14"
                               Margin="0,15,0,5"/>
                    <StackPanel>
                        <RadioButton Content="Утренний" IsChecked="True" Margin="0,0,0,4"/>
                        <RadioButton Content="Дневной" Margin="0,0,0,4"/>
                        <RadioButton Content="Без ограничений"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="Карточка абонемента" FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,10"/>

                    <Border Background="#2F5D50" Height="140" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Спортивный клуб" FontSize="15" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,12"/>
                            <TextBlock Text="Карта участника" Foreground="LightGray"
                                       FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock Text="К-2026-0325" Foreground="White"
                                       FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,15,0,0">
                        <Button Content="Оформить" Margin="0,0,10,0" Width="90" Height="25"/>
                        <Button Content="Отмена" Width="90" Height="25"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,20,0,0">
                    <TextBlock Text="Направления" FontWeight="Bold" FontSize="14"  Margin="0,0,0,5"/>
                    <WrapPanel>
                        <CheckBox Content="Тренажёрный зал" Margin="0,0,20,5"/>
                        <CheckBox Content="Бассейн" Margin="0,0,20,5"/>
                        <CheckBox Content="Йога" Margin="0,0,20,5"/>
                        <CheckBox Content="Пилатес" Margin="0,0,20,5"/>
                        <CheckBox Content="Бокс" Margin="0,0,20,5"/>
                        <CheckBox Content="Танцы" Margin="0,0,20,5"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
