<Window x:Class="pract3_trpo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract3_trpo"
        mc:Ignorable="d"
        Title="Спортивный абоонемент" Height="600" Width="800">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" FontSize="20" Text="Новый абонемент" Foreground="White" Background="Gray" Padding="15,12"/>
        <TextBlock DockPanel.Dock="Bottom" FontSize="14" Text="Стоимость: 3500 Р" Padding="15,12"/>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Клиент" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="ФИО" Margin="0,0,10,8"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Телефон" Margin="0,0,10,8"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Дата рождения" Margin="20,0,10,8"/>
                <DatePicker Grid.Row="1" Grid.Column="4" Margin="0,0,20,8"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Номер карты"   Margin="20,0,10,8"/>
                <TextBox Grid.Row="2" Grid.Column="3" Margin="0,0,20,2" Text="k-2026-035"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Параметры абонемента" FontWeight="Bold" FontSize="14" Margin="0,0,5,10"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Вид абонемента" Margin="0,0,10,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,5,8" SelectedIndex="0">
                    <ComboBoxItem Content="Стандарт"/>
                    <ComboBoxItem Content="Премиум"/>
                    <ComboBoxItem Content="VIP"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата начала" Margin="0,0,10,8"/>
                <DatePicker Grid.Row="2" Grid.Column="1" Margin="0,0,5,8"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Срок действия" Margin="0,0,10,8"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,5,8" SelectedIndex="0">
                    <ComboBoxItem Content="1 месяц"/>
                    <ComboBoxItem Content="3 месяца"/>
                    <ComboBoxItem Content="12 месяцев"/>
                </ComboBox>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Тренер" Margin="0,0,10,8"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,5,8" SelectedIndex="0">
                    <ComboBoxItem Content="Без тренера"/>
                    <ComboBoxItem Content="Соколов А.В."/>
                    <ComboBoxItem Content="Иванов В.К."/>
                </ComboBox>
            </Grid>
            <StackPanel VerticalAlignment="Top" Grid.Row="1" Grid.Column="1" Margin="0,0,0,0">
                <TextBlock Text="Карточка абонемента" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border Background="Gray" Height="150" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Спортивный клуб" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                        <TextBlock Text="Карта участника" Foreground="LightGray" FontSize="11" Margin="0,0,0,10"/>
                        <TextBlock Text="К-2026-0325" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Оформить" Margin="0,0,10,0" Width="90" Height="25"/>
                    <Button Content="Отмена" Width="90"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="Режим посещения" FontWeight="Bold" FontSize="14"/>
                <RadioButton Content="Утренний" IsChecked="true" Margin="0,0,0,4"/>
                <RadioButton Content="Дневной"  Margin="0,0,0,4"/>
                <RadioButton Content="Без ограничений"  Margin="0,0,0,10"/>
            </StackPanel>
            <TextBlock  Grid.Row="3" Text="Направления" FontSize="14" FontWeight="Bold" Margin="0,0,0,0"/>
            <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,25,0,0">

                <CheckBox Content="Тренажерный зал" Margin="0,0,20,8"/>
                <CheckBox Content="Бассейн" Margin="0,0,20,8"/>
                <CheckBox Content="Йога" Margin="0,0,20,8"/>
                <CheckBox Content="Пилатес" Margin="0,0,20,8"/>
                <CheckBox Content="Бокс" Margin="0,0,20,8"/>
                <CheckBox Content="Танцы" Margin="0,0,20,8"/>

            </WrapPanel>
        </Grid>
    </DockPanel>
</Window>
